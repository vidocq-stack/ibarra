<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee" version="3.0">
    <tlib-version>1.0</tlib-version>
    <short-name>example</short-name>
    <uri>urn:ibarra:example</uri>
    <tag>
        <name>frame</name>
        <tag-class>io.vidocq.ibarra.example.Frame</tag-class>
        <body-content>scriptless</body-content>
        <attribute><name>label</name><required>true</required></attribute>
        <attribute><name>heading</name><fragment>true</fragment></attribute>
    </tag>
</taglib>
