<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-RC1</version>
        <relativePath />
    </parent>

    <groupId>io.vidocq.ibarra</groupId>
    <artifactId>ibarra-parent</artifactId>
    <version>0.4.0-RC1</version>
    <packaging>pom</packaging>

    <name>Ibarra</name>
    <description>Jakarta Pages 4.0 (JSP) implementation — zero third-party dependency, strict Java Modules, pages translated and compiled at build time, Expression Language through Peano, servlet container through Foy</description>
    <url>https://codefloe.com/Vidocq/ibarra</url>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
    </developers>

    
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://codefloe.com/Vidocq/ibarra</url>
        <connection>scm:git:https://codefloe.com/Vidocq/ibarra.git</connection>
        <developerConnection>scm:git:git@codefloe.com:Vidocq/ibarra.git</developerConnection>
    </scm>

    <properties>
        
        <jakarta.pages.version>4.0.0</jakarta.pages.version>
        <jakarta.servlet.version>6.1.0</jakarta.servlet.version>
        <jakarta.el.version>6.0.1</jakarta.el.version>

        
        <peano.version>0.4.0-RC1</peano.version>
        <foy.version>0.4.0-RC1</foy.version>
        <chappe.version>0.4.0-RC1</chappe.version>

        
        <arquillian.version>1.8.0.Final</arquillian.version>
        <shrinkwrap.version>1.2.6</shrinkwrap.version>

        
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/ibarra-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    
    <modules>
        <module>ibarra-api</module>
        <module>ibarra-core</module>
        <module>ibarra-compiler</module>
        <module>ibarra-maven-plugin</module>
        <module>ibarra-foy</module>
        <module>ibarra-arquillian</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.vidocq.peano</groupId>
                <artifactId>peano-compiler</artifactId>
                <version>${peano.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.peano</groupId>
                <artifactId>peano-api</artifactId>
                <version>${peano.version}</version>
            </dependency>
            
            <dependency>
                <groupId>jakarta.servlet.jsp</groupId>
                <artifactId>jakarta.servlet.jsp-api</artifactId>
                <version>${jakarta.pages.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>${jakarta.servlet.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.el</groupId>
                <artifactId>jakarta.el-api</artifactId>
                <version>${jakarta.el.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.foy</groupId>
                <artifactId>foy-api</artifactId>
                <version>${foy.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.peano</groupId>
                <artifactId>peano-core</artifactId>
                <version>${peano.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.foy</groupId>
                <artifactId>foy-core</artifactId>
                <version>${foy.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.ibarra</groupId>
                <artifactId>ibarra-compiler</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ibarra</groupId>
                <artifactId>ibarra-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ibarra</groupId>
                <artifactId>ibarra-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ibarra</groupId>
                <artifactId>ibarra-arquillian</artifactId>
                <version>${project.version}</version>
            </dependency>

            
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-spi</artifactId>
                <version>${arquillian.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-impl-base</artifactId>
                <version>${arquillian.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.shrinkwrap</groupId>
                <artifactId>shrinkwrap-impl-base</artifactId>
                <version>${shrinkwrap.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        
        <profile>
            <id>tck</id>
            <modules>
                <module>ibarra-tck</module>
            </modules>
        </profile>
        
        <profile>
            <id>quality</id>
            <modules>
                <module>ibarra-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>