<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.vidocq.ibarra</groupId><artifactId>ibarra-parent</artifactId><version>0.4.0-RC1</version></parent>
    <artifactId>ibarra-foy</artifactId>
    <name>Ibarra :: Foy binding</name>
    <description>Precompiled page engine provider for Foy's application lifecycle</description>
    <dependencies>
        <dependency><groupId>io.vidocq.ibarra</groupId><artifactId>ibarra-api</artifactId></dependency>
        <dependency><groupId>io.vidocq.ibarra</groupId><artifactId>ibarra-core</artifactId></dependency>
        <dependency><groupId>io.vidocq.foy</groupId><artifactId>foy-api</artifactId></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.vidocq.foy</groupId><artifactId>foy-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.vidocq.ibarra</groupId><artifactId>ibarra-compiler</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.vidocq.chappe</groupId><artifactId>chappe-core</artifactId><version>${chappe.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.jboss.arquillian.container</groupId><artifactId>arquillian-container-spi</artifactId><version>1.8.0.Final</version><scope>test</scope></dependency>
        <dependency><groupId>org.jboss.shrinkwrap</groupId><artifactId>shrinkwrap-api</artifactId><version>1.2.6</version><scope>test</scope></dependency>
        <dependency><groupId>org.jboss.shrinkwrap</groupId><artifactId>shrinkwrap-impl-base</artifactId><version>1.2.6</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                <executions><execution><id>default-testCompile</id><configuration><useModulePath>false</useModulePath></configuration></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration><useModulePath>false</useModulePath></configuration>
            </plugin>
        </plugins>
    </build>
</project>
