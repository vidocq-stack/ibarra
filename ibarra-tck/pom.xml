<?xml version="1.0" encoding="UTF-8"?>
<!--
    ibarra-tck — runner for the official Jakarta Pages 4.0 TCK.

    In-reactor module gated by the `tck` Maven profile of ibarra-parent (TCK
    harmonisation — same pattern as every other Vidocq sub-project): a plain
    `mvn install` builds the ibarra-arquillian adapter (Arquillian/ShrinkWrap
    test tooling) but never this runner nor the official TCK.

    Two levels:
      -Ptck                 runs the runner tests (the adapter itself is the
                            published ibarra-arquillian, tested in the default build);
      -Ptck,tck-official    additionally resolves the official TCK artifact.

    The Pages 4.0 TCK moved from the Platform TCK into the jakartaee/pages
    repository (tck/ module) and was refactored to Arquillian + JUnit 5; it
    deploys WARs, so the real runner needs a container: Foy + Ibarra behind an
    Arquillian adapter, modelled on foy-tck (PLAN.md, milestone I8).
    Distribution (checked 2026-10-12): the standalone TCK is NOT on Maven Central.
    It ships as https://download.eclipse.org/jakartaee/pages/4.0/
    jakarta-pages-tck-4.0.0.zip, whose artefacts must be installed into the
    local Maven repository, like the Servlet TCK for foy-tck. Central only
    carries the Platform-mode variant jakarta.tck:pages-platform-tck (11.0.x).
    Coordinates below were verified against the jar's embedded upstream POM.
    prepare-tck.py preserves that POM and installs JavaTest 5.0, omitted from
    the standalone distribution. Arquillian clients use a test-only classpath;
    the precompiled application and Foy host run strictly as named modules.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.ibarra</groupId>
        <artifactId>ibarra-parent</artifactId>
        <version>0.4.0-RC1</version>
    </parent>

    <artifactId>ibarra-tck</artifactId>
    <name>Ibarra :: TCK</name>
    <description>Official Jakarta Pages 4.0 TCK runner — on the ibarra-arquillian adapter, modular Foy</description>

    <properties>
        <!-- Verified from the official 4.0.0 jar's embedded Maven POM. -->
        <tck.pages.groupId>jakarta.tck</tck.pages.groupId>
        <tck.pages.artifactId>jakarta-pages-tck</tck.pages.artifactId>
        <tck.pages.version>4.0.0</tck.pages.version>

        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencies>
        <!-- The Arquillian adapter (precompiles each WAR, deploys it on modular Foy). -->
        <dependency>
            <groupId>io.vidocq.ibarra</groupId>
            <artifactId>ibarra-arquillian</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><useModulePath>false</useModulePath></configuration></plugin>
    </plugins></build>

    <profiles>
        <profile>
            <id>tck-official</id>
            <dependencies>
                <dependency>
                    <groupId>${tck.pages.groupId}</groupId>
                    <artifactId>${tck.pages.artifactId}</artifactId>
                    <version>${tck.pages.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copy-spec-apis-for-signature-test</id>
                                <phase>process-test-resources</phase>
                                <goals><goal>copy</goal></goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>jakarta.servlet.jsp</groupId>
                                            <artifactId>jakarta.servlet.jsp-api</artifactId>
                                            <version>${jakarta.pages.version}</version>
                                            <destFileName>jakarta.servlet.jsp-api.jar</destFileName>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>jakarta.servlet</groupId>
                                            <artifactId>jakarta.servlet-api</artifactId>
                                            <version>${jakarta.servlet.version}</version>
                                            <destFileName>jakarta.servlet-api.jar</destFileName>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>jakarta.el</groupId>
                                            <artifactId>jakarta.el-api</artifactId>
                                            <version>${jakarta.el.version}</version>
                                            <destFileName>jakarta.el-api.jar</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                    <outputDirectory>${project.build.directory}/signature-api</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- The TCK jar is not a Java module: class path, like foy-tck. -->
                            <useModulePath>false</useModulePath>
                            <dependenciesToScan>
                                <dependency>${tck.pages.groupId}:${tck.pages.artifactId}</dependency>
                            </dependenciesToScan>
                            <includes><include>**/*IT.class</include></includes>
                            <trimStackTrace>false</trimStackTrace>
                            <systemPropertyVariables>
                                <porting.ts.url.class.1>ee.jakarta.tck.pages.lib.implementation.sun.common.SunRIURL</porting.ts.url.class.1>
                                <!-- Signature tools inspect spec API bytecode on the build machine;
                                     application and host deployment remain on the module path. -->
                                <jimage.dir>${project.build.directory}/signature-jimage</jimage.dir>
                                <sigTestClasspath>${project.build.directory}/signature-api/jakarta.servlet.jsp-api.jar${path.separator}${project.build.directory}/signature-api/jakarta.servlet-api.jar${path.separator}${project.build.directory}/signature-api/jakarta.el-api.jar${path.separator}${project.build.directory}/signature-jimage/java.base</sigTestClasspath>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
