<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.ibarra</groupId>
        <artifactId>ibarra-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>ibarra-coverage</artifactId>
    <packaging>pom</packaging>

    <name>Ibarra Coverage</name>
    <description>Aggregated JaCoCo report of the reactor, read by SonarQube (quality profile only)</description>

    <properties>
        <!-- Quality-only module, listed by the quality profile of ibarra-parent: never released,
             installed or deployed. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <!--
        report-aggregate reads these dependencies: in compile scope, their classes, sources and
        execution data make up the report; in test scope, only their execution data counts.
        Every module of the default reactor is listed, so the tests of one module count for the
        code they exercise in the others (Vidocq/vidocq#284). ibarra-tck only joins the reactor
        under the tck profile, and examples/precompiled-pages is built on its own, outside the
        reactor.
    -->
    <dependencies>
        <dependency>
            <groupId>io.vidocq.ibarra</groupId>
            <artifactId>ibarra-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.ibarra</groupId>
            <artifactId>ibarra-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.ibarra</groupId>
            <artifactId>ibarra-compiler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.ibarra</groupId>
            <artifactId>ibarra-maven-plugin</artifactId>
            <version>${project.version}</version>
            <type>maven-plugin</type>
        </dependency>
        <dependency>
            <groupId>io.vidocq.ibarra</groupId>
            <artifactId>ibarra-foy</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
